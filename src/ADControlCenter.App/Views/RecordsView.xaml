<UserControl x:Class="ADControlCenter.App.Views.RecordsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ADControlCenter.App.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="StatusCell">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource AccentText}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Fill" Value="{DynamicResource Subtle}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Locked"><Setter Property="Fill" Value="#DAA453" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stale"><Setter Property="Fill" Value="#DAA453" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Status}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="15,14,15,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Name}" Value="Users">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button Content="+  Create user" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="New" Style="{StaticResource Primary}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Name}" Value="Groups">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button Content="+  Create group" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="New" Style="{StaticResource Primary}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Heading}" Text="Directory records" />
          <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Tiny}" Margin="10,1,0,0" />
        </StackPanel>
      </DockPanel>
      <WrapPanel Grid.Row="1" Margin="15,2,15,10">
        <Grid Width="186" Margin="0,0,7,4">
          <TextBox x:Name="Find" Padding="29,5,8,5" AutomationProperties.Name="Search records" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=350}" />
          <v:Icon Width="14" Height="14" Kind="Search" Ink="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="9,0" IsHitTestVisible="False" />
          <TextBlock Text="Search records…" IsHitTestVisible="False" Margin="30,0,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text,ElementName=Find}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Filter}" MinWidth="109" Margin="0,0,7,4" AutomationProperties.Name="Record filter" />
        <StackPanel Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="Users">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" MinWidth="116" Margin="0,0,7,4" AutomationProperties.Name="Organizational unit" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="Computers">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" MinWidth="110" Margin="0,0,7,4" AutomationProperties.Name="Organizational unit" />
          <ComboBox ItemsSource="{Binding OperatingSystems}" SelectedItem="{Binding OS}" MinWidth="115" Margin="0,0,7,4" AutomationProperties.Name="Operating system" />
        </StackPanel>
      </WrapPanel>
      <Grid Grid.Row="2">
        <DataGrid x:Name="Table" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" MouseDoubleClick="OpenRecord" Sorting="Sorted" AutomationProperties.Name="Directory records" />
        <TextBlock Text="No matching records" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding View.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,8">
        <WrapPanel>
          <Button Content="View" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="View" Margin="2" />
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Name}" Value="Users">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button Content="Edit" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Edit" Margin="2" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Name}" Value="Groups">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button Content="Edit group" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Edit" Margin="2" />
          </StackPanel>
          <WrapPanel>
            <WrapPanel.Style>
              <Style TargetType="WrapPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Name}" Value="Users">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </WrapPanel.Style>
            <Button Content="DEMO enable" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Enable" Margin="2" Padding="8,6" FontSize="12" />
            <Button Content="DEMO disable" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Disable" Margin="2" Padding="8,6" FontSize="12" />
            <Button Content="DEMO unlock" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Unlock" Margin="2" Padding="8,6" FontSize="12" />
            <Button Content="DEMO reset password" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="ResetPassword" Margin="2" Padding="8,6" FontSize="12" />
          </WrapPanel>
        </WrapPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
