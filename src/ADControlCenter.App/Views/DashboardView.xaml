<UserControl x:Class="ADControlCenter.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ADControlCenter.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Grid Margin="0,0,0,9">
        <TextBlock Text="Workspace summary" FontWeight="SemiBold" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <v:Icon Kind="Calendar" Ink="{DynamicResource Muted}" Width="13" Height="13" Margin="0,0,6,0" />
          <TextBlock Text="{Binding DataContext.Today,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Tiny}" />
        </StackPanel>
      </Grid>
      <ItemsControl ItemsSource="{Binding Metrics}" Margin="-4,0,-4,14">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.Navigate,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Page}" Margin="4,0" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}" BorderThickness="0" Background="Transparent">
              <Border Style="{StaticResource Card}" Padding="14,13">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Left" CornerRadius="5" Width="27" Height="27" Background="#272F32">
                      <v:Icon Width="17" Height="17" Kind="{Binding Icon}" Ink="{Binding Accent}" />
                    </Border>
                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0" FontWeight="Medium" FontSize="12" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding Value}" FontSize="33" FontWeight="SemiBold" Margin="0,5,0,1" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" FontWeight="Normal" />
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.18*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Users by organizational unit" Style="{StaticResource Heading}" />
            <TextBlock Text="Account distribution · Top 6 units" Style="{StaticResource Caption}" Margin="0,3,0,11" />
            <ItemsControl ItemsSource="{Binding Units}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="21">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="85" />
                      <ColumnDefinition />
                      <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <ProgressBar Grid.Column="1" Value="{Binding Fraction,Mode=OneWay}" Maximum="1" Height="7" VerticalAlignment="Center">
                      <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                          <Grid x:Name="PART_Track">
                            <Border Background="{DynamicResource Hover}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" />
                          </Grid>
                        </ControlTemplate>
                      </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No users in the directory." Margin="0,10">
              <TextBlock.Style>
                <Style BasedOn="{StaticResource Caption}" TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Total}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Account health" Style="{StaticResource Heading}" />
            <TextBlock Text="Current user account states" Style="{StaticResource Caption}" Margin="0,3,0,10" />
            <Grid Height="129">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <Viewbox Margin="0,3,10,3" Stretch="Uniform">
                <Grid Width="120" Height="120">
                  <v:RingChart />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Total}" FontSize="24" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="USERS" Style="{StaticResource Tiny}" FontSize="9.5" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Viewbox>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Health}" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Height="28">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontFamily="Consolas" />
                      <Ellipse DockPanel.Dock="Left" Fill="{Binding Color}" Width="7" Height="7" Margin="0,0,7,0" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <StackPanel>
          <DockPanel Margin="17,12">
            <Button DockPanel.Dock="Right" Command="{Binding DataContext.Navigate,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Audit Logs" Background="Transparent" BorderThickness="0" Padding="6,2">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="View audit log" Foreground="{DynamicResource AccentText}" FontSize="12" />
                <v:Icon Kind="Arrow" Ink="{DynamicResource AccentText}" Width="14" Height="14" Margin="5,0,0,0" />
              </StackPanel>
            </Button>
            <TextBlock Text="Recent activity" Style="{StaticResource Heading}" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding Recent}" RowHeight="36" IsTabStop="False" CanUserResizeColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.35*" />
              <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1.4*" />
              <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="1.05*" />
              <DataGridTextColumn Header="Time" Binding="{Binding Timestamp.LocalDateTime,StringFormat={}{0:HH:mm}}" Width=".65*" />
              <DataGridTemplateColumn Header="Outcome" SortMemberPath="Outcome" Width=".85*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Tint}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource AccentText}" FontSize="11" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>