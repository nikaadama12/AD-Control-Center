<UserControl x:Class="ADControlCenter.App.Views.BulkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ADControlCenter.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <DockPanel>
        <Button Content="Choose CSV…" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Import" DockPanel.Dock="Right" Style="{StaticResource Primary}" VerticalAlignment="Center" />
        <StackPanel>
          <TextBlock Text="Import fictional users" Style="{StaticResource Heading}" />
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,12,0" Text="Use a UTF-8 CSV with DisplayName, Username and Department columns. A sample is included in samples/users.csv." />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="16,12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Tiny}" />
            <TextBlock Text="Import preview" Style="{StaticResource Heading}" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Search preview" Style="{StaticResource Caption}" Margin="0,0,8,0" />
            <TextBox Width="160" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=350}" AutomationProperties.Name="Search preview" />
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="100" Margin="8,0,0,0" AutomationProperties.Name="Validation filter" />
          </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
          <DataGrid ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Row" Binding="{Binding Row}" Width=".45*" />
              <DataGridTextColumn Header="Display name" Binding="{Binding Input.DisplayName}" Width="1.3*" />
              <DataGridTextColumn Header="Username" Binding="{Binding Input.Username}" Width="1.15*" />
              <DataGridTextColumn Header="Unit" Binding="{Binding Input.Department}" Width="1*" />
              <DataGridTextColumn Header="Validation" Binding="{Binding Result}" Width="1.65*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="ToolTip" Value="{Binding Result}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <v:Icon Kind="Bulk" Ink="{DynamicResource Muted}" Width="30" Height="30" />
            <TextBlock Text="Choose a CSV to preview proposed users." Style="{StaticResource Caption}" Margin="0,8" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="16,10">
          <DockPanel>
            <Button Content="Apply import…" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Apply" DockPanel.Dock="Right" Style="{StaticResource Primary}" />
            <TextBlock Text="{Binding FileLabel}" Style="{StaticResource Caption}" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>