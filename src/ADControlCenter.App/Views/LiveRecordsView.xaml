<UserControl x:Class="ADControlCenter.App.Views.LiveRecordsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:ADControlCenter.App.Presentation">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="Show"/></UserControl.Resources>
  <Border Style="{StaticResource Card}"><DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <WrapPanel Margin="0,0,0,8"><TextBlock Text="Search" Margin="0,0,6,0"/><TextBox Width="175" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Search live records"/>
        <ComboBox Margin="8,0,0,0" Width="230" ItemsSource="{Binding Locations}" SelectedItem="{Binding Parent}" ToolTip="{Binding Parent}" AutomationProperties.Name="Filter by parent"/>
        <ComboBox Margin="8,0,0,0" Width="112" ItemsSource="{Binding States}" SelectedItem="{Binding State}" AutomationProperties.Name="Filter by state"/>
      </WrapPanel>
      <Expander Header="OU hierarchy" Foreground="{DynamicResource Text}" Visibility="{Binding IsHierarchy,Converter={StaticResource Show}}" Margin="0,2,0,8" IsExpanded="True">
        <TreeView MaxHeight="145" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" ItemsSource="{Binding Roots}">
          <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Entry.Name}" Foreground="{DynamicResource Text}" ToolTip="{Binding Entry.DistinguishedName}"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
        </TreeView>
      </Expander>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Previous" Command="{Binding Previous}"/><Button Content="Next" Command="{Binding Next}" Margin="6,0,0,0"/>
      </StackPanel>
      <Button Content="View attributes" DockPanel.Dock="Left" Margin="0,0,10,0" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="View"/>
      <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}"/>
    </DockPanel>
    <DataGrid ItemsSource="{Binding Result.Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Live directory records">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.1*"/>
        <DataGridTextColumn x:Name="Account" Header="Account" Binding="{Binding Account}" Width="*"/>
        <DataGridTextColumn Header="Parent location" Binding="{Binding Parent}" Width="1.7*"/>
        <DataGridTextColumn x:Name="Platform" Header="Operating system" Binding="{Binding Platform}" Width="*"/>
        <DataGridTextColumn x:Name="State" Header="State" Binding="{Binding Status}" Width=".7*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel></Border>
</UserControl>
