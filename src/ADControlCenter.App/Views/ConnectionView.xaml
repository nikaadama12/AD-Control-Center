<UserControl x:Class="ADControlCenter.App.Views.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Secure directory connection" Style="{StaticResource Heading}" />
      <StackPanel Margin="0,12,0,0" IsEnabled="{Binding DataContext.CanConnect, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock Text="Domain controller hostname" Margin="0,4"/>
        <TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Domain controller hostname"/>
        <TextBlock Text="Transport" Margin="0,12,0,4"/>
        <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Name" SelectedItem="{Binding Choice}" AutomationProperties.Name="Transport"/>
        <TextBlock Text="Domain account (user@domain)" Margin="0,12,0,4"/>
        <TextBox Text="{Binding UserPrincipalName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Domain account" SpellCheck.IsEnabled="False"/>
        <TextBlock Text="Password" Margin="0,12,0,4"/>
        <PasswordBox x:Name="Secret" AutomationProperties.Name="Domain password" Background="{DynamicResource Field}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" Padding="9,6" MinHeight="33"/>
        <WrapPanel Margin="0,16,0,0"><Button Content="Test connection" Click="TestClick" Margin="0,0,8,0"/><Button Style="{StaticResource Primary}" Content="Connect read-only" Click="ConnectClick"/></WrapPanel>
      </StackPanel>
      <TextBlock Text="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Caption}" Margin="0,14,0,8" TextWrapping="Wrap"/>
      <WrapPanel><Button Content="Enable live administration…" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="EnableAdministration" Margin="0,0,8,0"/>
      <Button Content="Return to read-only" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="EndAdministration" Margin="0,0,8,0"/>
      <Button Content="Disconnect" HorizontalAlignment="Left" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Disconnect"/></WrapPanel>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
