<UserControl x:Class="ADControlCenter.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Workspace preferences" Style="{StaticResource Heading}" Margin="0,0,0,16" />
          <TextBlock Text="Appearance" Margin="0,0,0,6" />
          <ComboBox Width="150" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme" />
          <TextBlock Text="Export directory" Margin="0,15,0,6" />
          <DockPanel>
            <Button Content="Browse…" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Folder" DockPanel.Dock="Right" Margin="8,0,0,0" />
            <TextBox Text="{Binding Folder,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Export directory" />
          </DockPanel>
          <Button Content="Save preferences" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="SaveSettings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,17,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Demo data" Style="{StaticResource Heading}" />
          <TextBlock Text="Restore the fictional sample directory or clear its records. Both actions preserve audit history." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,14" />
          <WrapPanel>
            <Button Content="Restore samples…" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Reset" Margin="0,0,8,0" />
            <Button Content="Clear directory…" Command="{Binding DataContext.Run,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Clear" Foreground="{DynamicResource Danger}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>