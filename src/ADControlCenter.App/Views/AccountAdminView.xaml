<UserControl x:Class="ADControlCenter.App.Views.AccountAdminView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ADControlCenter.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Disposable accounts" Style="{StaticResource Heading}" />
          <TextBlock Text="{Binding AccessMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,3"/>
          <TextBlock Text="Search by name, username, department or OU" Margin="0,8,0,4" />
          <TextBox AutomationProperties.Name="Find disposable account" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Margin="0,8,0,8" AutomationProperties.Name="Disposable account" ItemsSource="{Binding Users}" SelectedItem="{Binding User}" DisplayMemberPath="Label">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
              </Style>
            </ComboBox.ItemContainerStyle>
          </ComboBox>
          <TextBlock Text="{Binding User.Location}" Style="{StaticResource Caption}" />
          <v:EmployeeFields DataContext="{Binding Form}" ReadOnlyIdentity="True" Margin="0,12,0,0" />
          <CheckBox IsEnabled="{Binding CanSetEnabled}" ToolTipService.ShowOnDisabled="True" ToolTip="Requires write access to the selected account state." Content="Account enabled" IsChecked="{Binding Enabled}" Foreground="{DynamicResource Text}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Approved security groups" Style="{StaticResource Heading}" />
          <TextBlock Text="Current approved memberships" Margin="0,8,0,3" />
          <TextBlock Text="{Binding CurrentMemberships}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding GroupAccessMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          <TextBlock Text="Search groups" Margin="0,10,0,3" />
          <TextBox Text="{Binding GroupQuery,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find approved groups" />
          <ItemsControl ItemsSource="{Binding VisibleGroups}" Margin="0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3">
                  <Button DockPanel.Dock="Right" Content="Direct members" Command="{Binding DataContext.Members,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Group}" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Group.Scope}" Margin="8,0" Style="{StaticResource Caption}" />
                  <CheckBox IsEnabled="{Binding DataContext.HasUser, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Content="{Binding Group.Name}" IsChecked="{Binding Selected}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Proposed membership changes" FontWeight="SemiBold" />
          <TextBlock Text="{Binding MembershipChanges}" Margin="0,4,0,8" TextWrapping="Wrap" />
          <Button Content="Review and apply…" ToolTip="Select an eligible account with delegated access to review changes." Command="{Binding Save}" Margin="0,0,8,0" HorizontalAlignment="Left" Style="{StaticResource Primary}" />
          <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>