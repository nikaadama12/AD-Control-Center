<Window x:Class="ADControlCenter.App.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:ADControlCenter.App.Views" xmlns:p="clr-namespace:ADControlCenter.App.Presentation" Style="{StaticResource {x:Type Window}}" Title="AD Control Center" Icon="/Assets/app.ico" Width="1380" Height="920" MinWidth="860" MinHeight="570" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <v:SameValue x:Key="Same" />
    <DataTemplate DataType="{x:Type p:DashboardPage}">
      <v:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type p:RecordsPage}">
      <v:RecordsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type p:BulkPage}">
      <v:BulkView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type p:ReportsPage}">
      <v:ReportsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type p:SettingsPage}">
      <v:SettingsView />
    </DataTemplate>
    <DataTemplate x:Key="NavRow">
      <Button Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,2" Padding="12,9" AutomationProperties.Name="{Binding Name}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Style.Triggers>
              <DataTrigger Value="True">
                <DataTrigger.Binding>
                  <MultiBinding Converter="{StaticResource Same}">
                    <Binding Path="Name" />
                    <Binding Path="DataContext.Current.Name" RelativeSource="{RelativeSource AncestorType=Window}" />
                  </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{DynamicResource Tint}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal">
          <v:Icon Kind="{Binding Icon}" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" />
          <TextBlock Margin="12,0,0,0" Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="Rail" Width="214" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="14,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="4,24,0,24">
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" Background="{DynamicResource Accent}" CornerRadius="9">
              <v:Icon Kind="Logo" Ink="#1A2A18" Width="26" Height="26" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="AD Control" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="Center" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,-3,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <ContentControl Content="{Binding SettingsNav}" ContentTemplate="{StaticResource NavRow}" Margin="0,0,0,14" />
          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="2,16">
            <StackPanel Orientation="Horizontal">
              <Border Background="{DynamicResource Tint}" Width="33" Height="33" CornerRadius="17">
                <TextBlock Text="DO" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" />
              </Border>
              <StackPanel Margin="10,0">
                <TextBlock Text="Demo Operator" FontWeight="SemiBold" />
                <TextBlock Text="Local administrator demo" Style="{StaticResource Caption}" FontSize="10.5" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,11" Margin="0,0,0,24">
              <DockPanel>
                <v:Icon Kind="Directory" Ink="{DynamicResource AccentText}" Width="17" Height="17" Margin="0,0,8,0" />
                <StackPanel>
                  <TextBlock Text="LOCAL DIRECTORY" Style="{StaticResource Tiny}" FontSize="9.5" />
                  <TextBlock Text="northstar.example" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock Text="WORKSPACE" Style="{StaticResource Tiny}" Margin="10,0,0,7" />
            <ItemsControl ItemsSource="{Binding Navigation}" ItemTemplate="{StaticResource NavRow}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Padding="24,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource Tint}" CornerRadius="4" Padding="8,4">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentText}" Margin="0,0,6,0" />
                <TextBlock Text="DEMO MODE" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource AccentText}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <v:Icon Kind="Directory" Width="15" Height="15" Ink="{DynamicResource Muted}" />
            <TextBlock Text="Workspace" Style="{StaticResource Caption}" Margin="8,0" />
            <TextBlock Text="/" Foreground="{DynamicResource Subtle}" />
            <TextBlock Text="{Binding Current.Name}" FontSize="12" Margin="9,0,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="24,22,24,17">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,8,0" />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding Run}" CommandParameter="Refresh" ToolTip="Refresh directory view">
          <StackPanel Orientation="Horizontal">
            <v:Icon Kind="Refresh" Width="14" Height="14" Ink="{DynamicResource Muted}" />
            <TextBlock Text="Refresh" Margin="7,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>
      <ContentControl Grid.Row="2" Content="{Binding Page}" Margin="24,0,24,14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="16,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="v1.0.0" Style="{StaticResource Tiny}" />
          <Ellipse DockPanel.Dock="Left" Fill="{DynamicResource AccentText}" Width="6" Height="6" Margin="0,0,7,0" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource Tiny}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>